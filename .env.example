# Copy this file to .env and fill in your real values
# Server-side only — NEVER put these keys in any JS file that ships to the browser.

# Google Gemini API key (for the AI chat agent)
GEMINI_API_KEY="your-gemini-api-key"

# Optional: override the model
GEMINI_MODEL=gemini-3.6-flash

# Server port
PORT=3000

# ── Email notifications (Gmail) ─────────────────────────────
# Form submissions are emailed to EMAIL_TO.
# IMPORTANT: for Gmail you MUST use an "App Password" as SMTP_PASS,
# not your normal Gmail password.
# Get it here: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=moldrivoai123@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_TO=moldrivoai123@gmail.com
